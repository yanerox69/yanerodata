# Puerto de escucha del servidor
PORT=3000
NODE_ENV=production

# Secreto para tokens JWT del panel de administración (mínimo 32 caracteres).
# Genere uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si se deja vacío, el servidor genera uno aleatorio y lo guarda en db/.jwt-secret
JWT_SECRET=""

# URL base de la aplicación (usado para OpenGraph, Sitemap y enlaces)
APP_URL="http://localhost:3000"

# Ruta de la base de datos SQLite
DATABASE_PATH="./db/homenaje.db"

# Número de proxies inversos delante de la app (1 = Nginx). Use 0 si no hay proxy.
TRUST_PROXY=1

# Inicio de sesión con Google para el panel /admin
# 1. Cree un "ID de cliente de OAuth" tipo "Aplicación web" en https://console.cloud.google.com/apis/credentials
# 2. En "Orígenes autorizados de JavaScript" agregue la URL del sitio (ej. https://homenaje-joseaugusto.com y http://localhost:3000)
GOOGLE_CLIENT_ID=""
# Correos de Google autorizados a entrar al panel, separados por comas
ADMIN_EMAILS=""

