# "mock" needs no GPU/API key and is great for local UI development.
# Switch to "vllm" once you have a model endpoint on AMD hardware — either
# your own vLLM server on an AMD Developer Cloud instance, OR Fireworks AI
# (no GPU/instance to manage; their inference runs on AMD Instinct GPUs —
# see deploy/AMD_DEPLOYMENT.md "Option B").
LLM_PROVIDER=mock

# Option A — self-hosted vLLM on an AMD Developer Cloud instance:
#   LLM_BASE_URL=http://<instance-ip>:8000/v1
#   LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
#   LLM_API_KEY=not-needed
#
# Option B — Fireworks AI (OpenAI-compatible, runs on AMD Instinct GPUs,
# no card required for the $50 AMD hackathon credit):
#   LLM_BASE_URL=https://api.fireworks.ai/inference/v1
#   LLM_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct
#   LLM_API_KEY=<your Fireworks API key>
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_API_KEY=not-needed

# Optional: use Tavily for higher-quality web search instead of the
# DuckDuckGo HTML fallback.
TAVILY_API_KEY=

MAX_AGENT_STEPS=6
CORS_ORIGINS=*
