# "mock" needs no GPU/API key and is great for local UI development.
# Switch to "vllm" once you have a model served on AMD Instinct GPUs (ROCm).
LLM_PROVIDER=mock

# OpenAI-compatible endpoint, e.g. the one exposed by `vllm serve` on your
# AMD Developer Cloud instance.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LLM_API_KEY=not-needed

# Optional: use Tavily for higher-quality web search instead of the
# DuckDuckGo HTML fallback.
TAVILY_API_KEY=

MAX_AGENT_STEPS=6
CORS_ORIGINS=*
